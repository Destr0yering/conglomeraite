# Installed as /etc/conglomeraite/conglomeraite.env on first deployment only.
# Keep the real file root-readable and never commit credentials.
QWEN_API_KEY=
CONGLOMERAITE_QWEN_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CONGLOMERAITE_QWEN_MODEL=qwen-plus
CONGLOMERAITE_LOCAL_KIND=sysop_bridge
CONGLOMERAITE_LOCAL_ENDPOINT=http://127.0.0.1:8790
CONGLOMERAITE_LOCAL_MODEL=sysop-agents
CONGLOMERAITE_OFFLINE=false

# Override only if the target uses a managed virtual environment.
CONGLOMERAITE_PYTHON=/usr/bin/python3
CONGLOMERAITE_CONFIG=/etc/conglomeraite/config.json
