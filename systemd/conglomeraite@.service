[Unit]
Description=ConglomerAIte bounded evaluation task %i
Documentation=file:/opt/conglomeraite/current/docs/architecture.md
Wants=sysop-qwen-bridge.service
After=sysop-qwen-bridge.service

[Service]
Type=oneshot
User=conglomeraite
Group=conglomeraite
Slice=conglomeraite.slice
WorkingDirectory=/opt/conglomeraite/current
Environment=CONGLOMERAITE_PYTHON=/usr/bin/python3
Environment=CONGLOMERAITE_CONFIG=/etc/conglomeraite/config.json
Environment=PYTHONPATH=/opt/conglomeraite/current/src
EnvironmentFile=-/etc/conglomeraite/conglomeraite.env
ExecStartPre=/usr/bin/install -d -m 0750 /var/lib/conglomeraite/results
ExecStart=/usr/bin/env ${CONGLOMERAITE_PYTHON} -m conglomeraite --config ${CONGLOMERAITE_CONFIG} --require-memory-monitor --journal-summary --result-file /var/lib/conglomeraite/results/%i.json --trace-file /var/lib/conglomeraite/state/%i.trace.json --task-file /var/lib/conglomeraite/tasks/%i.json

# Keep the controller alive long enough to record why the model was shed.
OOMScoreAdjust=-250
MemoryHigh=384M
MemoryMax=640M
MemorySwapMax=512M
TasksMax=96
OOMPolicy=stop
TimeoutStartSec=330s
TimeoutStopSec=30s
KillSignal=SIGINT

# The code tree is immutable; only durable state and runtime scratch are writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/conglomeraite /run/conglomeraite
StateDirectory=conglomeraite
StateDirectoryMode=0750
RuntimeDirectory=conglomeraite
RuntimeDirectoryMode=0750
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=conglomeraite-%i
