* text=auto

# Deployment artifacts execute on Linux. Keep their line endings stable even
# when release archives are created from a Windows checkout.
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.json text eol=lf
